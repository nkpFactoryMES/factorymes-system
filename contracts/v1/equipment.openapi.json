          "System"
        ],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "description": ""
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation. See business rules and row scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "mes.schemas.json#/$defs/ConfigAck"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or schema validation failed",
